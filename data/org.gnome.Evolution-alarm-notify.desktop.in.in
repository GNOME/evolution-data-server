[Desktop Entry]
Type=Application
Name=Events and Tasks Reminders
Comment=Event and task notifications
Icon=org.gnome.Evolution-alarm-notify
Exec=@privlibexecdir@/evolution-alarm-notify --autostart
Terminal=false
Categories=
NoDisplay=true
NotShowIn=GNOME;
X-Meego-Priority=Low
X-GNOME-UsesNotifications=true
X-systemd-skip=true
